# Copy this file to .env (same directory) and fill in your values.
# .env is gitignored so secrets stay local.

# ESPN session cookies. Get these from your browser cookies on espn.com after login.
ESPN_SWID={REPLACE-WITH-YOUR-SWID}
ESPN_S2=REPLACE_WITH_YOUR_ESPN_S2_COOKIE

# Optional overrides
# ESPN_LEAGUE_ID=1200
# ESPN_SEASON=2026
