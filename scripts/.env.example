# Copy this file to .env (same directory) and fill in your values.
# .env is gitignored so secrets stay local.

# ESPN session cookies. Get these from your browser cookies on espn.com after login.
ESPN_SWID={REPLACE-WITH-YOUR-SWID}
ESPN_S2=REPLACE_WITH_YOUR_ESPN_S2_COOKIE

# Optional overrides
# ESPN_LEAGUE_ID=1200
# ESPN_SEASON=2026

# Supabase service-role key (Project Settings -> API -> "service_role").
# Required only by scripts/send_invite.py — never commit this value.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY

# Gmail SMTP for the daily digest email (scripts/daily_report.py).
# Same account/App Password you set in Supabase Auth -> SMTP.
# Optional — without these, the digest is written to /tmp/ but not emailed.
# SMTP_USER=jwarshafsky@gmail.com
# SMTP_PASS=YOUR_16_CHAR_APP_PASSWORD
